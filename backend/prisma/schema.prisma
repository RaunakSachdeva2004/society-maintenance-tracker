// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  resident
  admin
}

// Phase 1 Model
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(resident)
  flatNumber   String?
  createdAt    DateTime @default(now())
}
